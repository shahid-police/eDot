<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3c47f8b2-5705-4308-a6ea-7637fac6a8b0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- SkiaSharp.NativeAssets.Linux.NoDependencies is referenced by Elegance.Infrastructure (where
         SkiaSharp is actually used), but a RID-specific native-asset-only package reached only
         through a ProjectReference chain does not get its runtimes/linux-x64/native/libSkiaSharp.so
         copied into a `dotnet publish -r linux-x64` output - it has to be referenced directly by the
         executable project for that. Without this, image uploads fail on the Linux server with
         "That file is not a valid image". -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elegance.Application\Elegance.Application.csproj" />
    <ProjectReference Include="..\Elegance.Infrastructure\Elegance.Infrastructure.csproj" />
  </ItemGroup>

</Project>
